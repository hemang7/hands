# Model access for discovery runs (replay never needs it)
OPENAI_API_KEY=sk-...
HANDS_MODEL=gpt-4.1

# Credentials the automation uses to sign on to the target app. Referenced from artifacts by
# env var NAME only; values are never written to artifacts, logs or model context.
LEGACYCORE_USER=teller1
LEGACYCORE_PASSWORD=teller1-pass

# Optional: use a system Chromium instead of the Playwright-managed download
# HANDS_CHROMIUM_PATH=/usr/bin/chromium
