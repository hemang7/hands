{
  "schemaVersion": "1.0",
  "id": "lookup_member_balance",
  "version": 1,
  "status": "draft",
  "name": "lookup member balance",
  "description": "Looked up member {memberId} and read the share savings balance from the member detail screen.",
  "app": {
