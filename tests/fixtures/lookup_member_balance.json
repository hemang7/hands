            "column": "Current Balance"
          },
          {
            "kind": "grid",
            "row": "PRIMARY SAVINGS",
            "column": "Current Balance"
          },
          {
            "kind": "grid",
            "row": "S01",
            "column": "Current Balance"
          },
          {
            "kind": "anchor",
            "anchor": "PRIMARY SAVINGS",
            "role": "cell"
