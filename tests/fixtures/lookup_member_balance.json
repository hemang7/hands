    {
      "id": "s6_click",
      "kind": "click",
      "description": "Run the member inquiry",
      "target": {
        "description": "the \"Inquire\" button in frame \"main\"",
        "frame": {
          "name": "main",
          "urlPattern": "/t/alpha/members"
