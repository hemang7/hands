      "kind": "extract",
      "description": "The Current Balance column of the Share Savings row holds the savings balance",
      "target": {
        "description": "the \"Current Balance\" cell of the \"Share Savings\" row in frame \"main\"",
        "frame": {
          "name": "main",
          "urlPattern": "/t/alpha/members/:id"
