{
  "name": "hands",
  "version": "1.0.0",
  "description": "Computer-use automation system: an LLM discovers a flow on a legacy UI once, records it as a typed capability, and a deterministic engine replays it with error handling, guardrails and human handoff.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "target": "tsx target-app/server.ts",
    "hands": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "demo:offline": "LLM=scripted OUT=runs/evidence-offline bash scripts/make-evidence.sh",
    "evidence": "bash scripts/make-evidence.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cookie-session": "^2.1.1",
    "express": "^4.22.2",
    "openai": "^7.10.0",
    "playwright": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.25",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
