{
  "schemaVersion": "1.0",
  "id": "open_sub_account",
  "version": 1,
  "status": "approved",
  "name": "Open New Sub-Account for Member",
  "description": "This capability allows you to look up a member using Member Inquiry, open a new sub-account for them (without using the Transactions menu), specify the account type, nickname, and initial deposit, review and confirm the details, and then stop on the screen displaying the host confirmation number. The process ensures the sub-account is created according to the provided specifications and returns the confirmation number for reference.",
  "app": {
    "profile": "legacycore-teller",
    "surface": "web",
    "entryUrl": "http://localhost:4010/t/alpha/login"
  },
  "inputs": {
    "memberId": {
      "type": "string",
      "description": "The unique identifier of the member for whom the new sub-account will be opened.",
      "required": true,
      "pattern": "^\\d{5}$",
      "sensitivity": "pii"
    },
    "accountType": {
      "type": "string",
      "description": "The type of sub-account to be created (e.g., Club Savings).",
      "required": true,
      "sensitivity": "none",
      "example": "Club Savings"
    },
    "nickname": {
      "type": "string",
      "description": "The nickname to assign to the new sub-account.",
      "required": true,
      "sensitivity": "none",
      "example": "VACATION FUND"
    },
    "deposit": {
      "type": "number",
      "description": "The initial deposit amount (in dollars) for the new sub-account.",
      "required": true,
      "sensitivity": "none",
      "example": "25.00"
    }
  },
  "outputs": {
    "host_confirmation_number": {
      "type": "string",
      "description": "The confirmation number displayed by the host system after successfully opening the new sub-account.",
      "sensitivity": "none",
      "fromStep": "s13_extract"
    }
  },
